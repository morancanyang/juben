# Copy to .env. Actual credentials never belong in the web directory.
APP_ENV=development
# Local launch uses SQLite. Docker Compose injects PostgreSQL instead.
# DATABASE_URL=postgresql+psycopg://mystery:CHANGE_ME@localhost:5432/mystery
PROVIDER=mock
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4.1-mini
MODEL_TIMEOUT_SECONDS=18
MODEL_DAILY_CALL_LIMIT=100
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8765,http://localhost:8765
